{
  "name": "banklite-frontend",
  "private": true,
  "description": "Frontend estático de BankLite (páginas, scripts y estilos). Solo herramientas de calidad: no hay build.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,css,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,css,mjs}\"",
    "test": "node --test scripts/puntos-progreso.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
